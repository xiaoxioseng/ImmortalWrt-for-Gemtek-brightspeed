From: XR1710G Community <xr1710g-community@localhost>
Date: Tue, 29 Sep 2026 20:30:00 +0800
Subject: [PATCH] wifi: mac80211: resolve mesh next hop for hardware forward path

mac80211 currently exposes ndo_fill_forward_path only through the 802.3
encapsulation netdev ops and resolves AP/AP-VLAN/station interfaces only.
An 802.11s mesh netdev therefore never reaches a driver's
net_fill_forward_path callback, even when the driver and hardware can
perform Wi-Fi packet offload.

Keep the normal mesh TX path unchanged, but expose the forward-path hook on
the regular data netdev ops. For an established unicast mesh route, resolve
the destination (or its Mesh Portal Proxy) to the active mesh path and pass
the path's next-hop STA to the driver. If no active path exists, retain the
software fallback.

This allows Airoha PPE flow offload to hand an established mesh flow to the
MT7996 WDMA/NPU path without changing route discovery or normal mesh TX.

--- a/net/mac80211/iface.c
+++ b/net/mac80211/iface.c
@@ -964,6 +964,11 @@ static void ieee80211_uninit(struct net_device *dev)
 	ieee80211_teardown_sdata(sdata);
 }
 
+static int ieee80211_netdev_fill_forward_path(struct net_device_path_ctx *ctx,
+					      struct net_device_path *path);
+
 static int ieee80211_netdev_setup_tc(struct net_device *dev,
 				     enum tc_setup_type type, void *type_data)
 {
@@ -982,6 +987,7 @@ static const struct net_device_ops ieee80211_dataif_ops = {
 	.ndo_start_xmit		= ieee80211_subif_start_xmit,
 	.ndo_set_rx_mode	= ieee80211_set_multicast_list,
 	.ndo_set_mac_address 	= ieee80211_change_mac,
+	.ndo_fill_forward_path	= ieee80211_netdev_fill_forward_path,
 	.ndo_setup_tc		= ieee80211_netdev_setup_tc,
 };
 
@@ -1055,6 +1061,31 @@ static int ieee80211_netdev_fill_forward_path(struct net_device_path_ctx *ctx,
 
 		sta = sta_info_get(sdata, sdata->deflink.u.mgd.bssid);
 		break;
+	case NL80211_IFTYPE_MESH_POINT: {
+		struct mesh_path *mpath, *mppath;
+
+		if (is_multicast_ether_addr(ctx->daddr))
+			goto out;
+
+		/* First try a native mesh destination. For a station behind a
+		 * mesh portal, resolve the proxy entry to the portal's mesh path.
+		 * Do not start path discovery here: unresolved traffic must keep
+		 * using the normal mac80211 software path.
+		 */
+		mpath = mesh_path_lookup(sdata, ctx->daddr);
+		if (!mpath || !(mpath->flags & MESH_PATH_ACTIVE)) {
+			mppath = mpp_path_lookup(sdata, ctx->daddr);
+			if (!mppath)
+				goto out;
+
+			mpath = mesh_path_lookup(sdata, mppath->mpp);
+		}
+
+		if (!mpath || !(mpath->flags & MESH_PATH_ACTIVE))
+			goto out;
+
+		sta = rcu_dereference(mpath->next_hop);
+		break;
+	}
 	default:
 		goto out;
 	}
